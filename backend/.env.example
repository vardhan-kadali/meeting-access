# MEETING ACCESS Backend Configuration
# Copy this file to backend/.env and populate with your own keys.

# Environment: development / production
ENVIRONMENT=development

# Google Gemini API Key (obtained from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model ID (e.g., gemini-3.5-flash-lite, gemini-3.1-flash-lite, etc.)
GEMINI_MODEL=gemini-3.5-flash-lite

# Configurable Gemini Fallback Models (comma-separated or JSON list, attempted in order)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# API Server Settings
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PDF Ingestion & Extraction Limits
MAX_UPLOAD_SIZE_MB=15
MAX_PAGE_COUNT=100
